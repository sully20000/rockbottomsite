# Copy this file to .env and adjust the values for your server.
# Load it with your process manager, for example:
#   node --env-file=.env server.js
# Never commit the real .env file.

# HTTP port and interface
PORT=3000
HOST=127.0.0.1

# Use production mode behind HTTPS
NODE_ENV=production

# Set to 1 when Nginx, Caddy, a load balancer or a container platform is in front
TRUST_PROXY=1

# Persistent data folder (database and setup token)
DATA_DIR=./data

# Where npm run backup writes snapshots
BACKUP_DIR=./backups

# Optional: choose the first-run setup token instead of a random one.
# Ignored once an administrator account exists.
# ADMIN_SETUP_TOKEN=

# Optional: used only by npm run create-admin, not by the web server.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
