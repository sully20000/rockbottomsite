<%- include('partials/public-head', {
  content,
  pageTitle: '',
  pageDescription: content.site.metaDescription,
  canonicalUrl: origin + '/',
  ogImage: origin + safeImage(content.hero.image, '/images/hero-forest.jpg'),
  noindex: preview,
  bodyClass: bodyClass || 'page-home',
  preview,
  preloadImage: safeImage(content.hero.image, '/images/hero-forest.jpg')
}) %>
<%- include('partials/public-nav', { content, isHome: true, solidHeader: false }) %>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <img src="<%= safeImage(content.hero.image, '/images/hero-forest.jpg') %>" alt="<%= content.hero.imageAlt %>" fetchpriority="high" width="2200" height="1467">
    </div>
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light reveal"<%- editAttr('hero.eyebrow') %>>
          <span class="eyebrow-line" aria-hidden="true"></span>
          <%= content.hero.eyebrow %>
        </p>
        <h1 id="hero-title" class="hero-title reveal"<%- editAttr('hero.title') %>>
          <% const titleParts = content.hero.title.split('–'); %>
          <% if (titleParts.length > 1) { %>
            <span><%= titleParts[0].trim() %></span>
            <em><%= titleParts.slice(1).join('–').trim() %></em>
          <% } else { %>
            <span><%= content.hero.title %></span>
          <% } %>
        </h1>
        <p class="hero-intro reveal"<%- editAttr('hero.intro') %>><%= content.hero.intro %></p>
        <div class="hero-actions reveal">
          <a class="btn btn-primary" href="#about">
            <span<%- editAttr('hero.primaryCta') %>><%= content.hero.primaryCta %></span>
            <%- icon('arrow-down') %>
          </a>
        </div>
        <p class="hero-scroll-note reveal"<%- editAttr('hero.scrollLabel') %>>
          <span class="scroll-line" aria-hidden="true"></span>
          <%= content.hero.scrollLabel %>
        </p>
      </div>

      <aside class="hero-side reveal" aria-label="A note about this website">
        <span class="hero-side-mark" aria-hidden="true">✦</span>
        <p<%- editAttr('disclaimer.shortText') %>><%= content.disclaimer.shortText %></p>
        <a href="/disclaimer"><span<%- editAttr('footer.disclaimerLabel') %>><%= content.footer.disclaimerLabel %></span> <%- icon('arrow-right') %></a>
      </aside>
    </div>
    <a class="scroll-cue" href="#disclaimer" aria-label="Scroll to the important note">
      <span></span>
    </a>
  </section>

  <section class="disclaimer-section" id="disclaimer" aria-labelledby="disclaimer-title">
    <div class="container">
      <div class="disclaimer-card reveal">
        <div class="disclaimer-icon" aria-hidden="true"><%- icon('info') %></div>
        <div class="disclaimer-copy">
          <p class="card-kicker"<%- editAttr('disclaimer.label') %>><%= content.disclaimer.label %></p>
          <h2 id="disclaimer-title" class="visually-hidden"><%= content.disclaimer.label %></h2>
          <p<%- editAttr('disclaimer.text') %>><%= content.disclaimer.text %></p>
        </div>
        <a class="text-link" href="/disclaimer"><span<%- editAttr('ui.readDisclaimer') %>><%= content.ui.readDisclaimer %></span> <%- icon('arrow-right') %></a>
      </div>
    </div>
  </section>

  <section class="letter-section" id="about" aria-labelledby="letter-title">
    <div class="container letter-grid">
      <div class="letter reveal">
        <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('letter.eyebrow') %>><%= content.letter.eyebrow %></span></p>
        <h2 id="letter-title"<%- editAttr('letter.heading') %>><%= content.letter.heading %></h2>
        <div class="letter-body">
          <% content.letter.paragraphs.forEach(function(paragraph, index) { %>
            <p class="<%= index === 0 ? 'letter-lead' : '' %>"<%- editAttr('letter.paragraphs.' + index) %>><%= paragraph %></p>
          <% }) %>
        </div>
        <p class="signature">
          <span class="signature-line" aria-hidden="true"></span>
          <span<%- editAttr('letter.signature') %>><%= content.letter.signature %></span>
        </p>
      </div>

      <aside class="daily-card reveal" aria-labelledby="daily-title">
        <img class="daily-bg" src="<%= safeImage(content.daily.image, '/images/calm-lake.jpg') %>" alt="<%= content.daily.imageAlt %>" loading="lazy" width="1800" height="1200">
        <div class="daily-overlay" aria-hidden="true"></div>
        <div class="daily-content">
          <p class="daily-kicker"><%- icon('sunrise') %> <span<%- editAttr('daily.eyebrow') %>><%= content.daily.eyebrow %></span></p>
          <h2 id="daily-title" class="daily-heading"<%- editAttr('daily.heading') %>><%= content.daily.heading %></h2>
          <blockquote class="daily-quote">
            <p>“<span<%- editAttr('daily.messages.' + dailyIndex) %>><%= dailyText %></span>”</p>
          </blockquote>
          <p class="daily-note"<%- editAttr('daily.note') %>><%= content.daily.note %></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-paper symptoms-section" id="symptoms" aria-labelledby="symptoms-title">
    <div class="container">
      <div class="section-head section-head-paper reveal">
        <p class="eyebrow eyebrow-dark"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('symptoms.eyebrow') %>><%= content.symptoms.eyebrow %></span></p>
        <h2 id="symptoms-title"<%- editAttr('symptoms.heading') %>><%= content.symptoms.heading %></h2>
        <p class="section-sub"<%- editAttr('symptoms.subtitle') %>><%= content.symptoms.subtitle %></p>
      </div>

      <ul class="symptom-grid" role="list">
        <% content.symptoms.items.forEach(function(item, index) { %>
          <li class="symptom-card reveal" style="--i: <%= index %>">
            <span class="symptom-icon"><%- icon(item.icon) %></span>
            <span class="symptom-title"<%- editAttr('symptoms.items.' + index + '.title') %>><%= item.title %></span>
            <span class="symptom-index" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
          </li>
        <% }) %>
      </ul>

      <div class="symptoms-closing reveal">
        <span class="quote-mark" aria-hidden="true">“</span>
        <p<%- editAttr('symptoms.closing') %>><%= content.symptoms.closing %></p>
        <p class="micro-note"<%- editAttr('symptoms.note') %>><%= content.symptoms.note %></p>
      </div>
    </div>
  </section>

  <section class="start-helper-section" id="start-helper" aria-labelledby="start-helper-title">
    <div class="container">
      <div class="helper-head reveal">
        <div>
          <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('startHelper.eyebrow') %>><%= content.startHelper.eyebrow %></span></p>
          <h2 id="start-helper-title"<%- editAttr('startHelper.heading') %>><%= content.startHelper.heading %></h2>
          <p class="section-sub"<%- editAttr('startHelper.intro') %>><%= content.startHelper.intro %></p>
        </div>
        <a class="btn btn-ghost" href="#steps" data-open-helper>
          <%- icon('sparkles') %>
          <span><%= content.nav.startLabel %></span>
        </a>
      </div>

      <div class="helper-grid">
        <% content.startHelper.options.forEach(function(option, index) { %>
          <article class="helper-card reveal" style="--i: <%= index %>">
            <span class="helper-number" aria-hidden="true">0<%= index + 1 %></span>
            <span class="helper-icon"><%- icon(option.icon) %></span>
            <h3<%- editAttr('startHelper.options.' + index + '.title') %>><%= option.title %></h3>
            <p<%- editAttr('startHelper.options.' + index + '.text') %>><%= option.text %></p>
            <a class="text-link" href="<%= safeActionHref(option.actionHref) %>"><span<%- editAttr('startHelper.options.' + index + '.actionLabel') %>><%= option.actionLabel %></span> <%- icon('arrow-right') %></a>
          </article>
        <% }) %>
      </div>

      <aside class="text-support-card reveal" aria-labelledby="text-support-title">
        <span class="text-support-icon" aria-hidden="true"><%- icon('message-text') %></span>
        <div class="text-support-copy">
          <h3 id="text-support-title"<%- editAttr('startHelper.textSupportHeading') %>><%= content.startHelper.textSupportHeading %></h3>
          <p<%- editAttr('startHelper.textSupportText') %>><%= content.startHelper.textSupportText %></p>
        </div>
        <a class="text-support-button" href="<%= smsHref(content.startHelper.textSupportNumber, '#') %>">
          <%- icon('message-text') %>
          <span<%- editAttr('startHelper.textSupportAction') %>><%= content.startHelper.textSupportAction %></span>
        </a>
      </aside>
    </div>
  </section>

  <section class="section section-dark steps-section" id="steps" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head section-head-dark reveal">
        <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('tips.eyebrow') %>><%= content.tips.eyebrow %></span></p>
        <h2 id="steps-title"<%- editAttr('tips.heading') %>><%= content.tips.heading %></h2>
        <p class="section-sub"<%- editAttr('tips.subtitle') %>><%= content.tips.subtitle %></p>
      </div>

      <div class="steps-grid">
        <aside class="steps-media reveal">
          <img src="<%= safeImage(content.tips.image, '/images/ferns.jpg') %>" alt="<%= content.tips.imageAlt %>" loading="lazy" width="1800" height="1200">
          <div class="steps-media-overlay" aria-hidden="true"></div>
          <div class="steps-media-copy">
            <span class="steps-media-number"<%- editAttr('ui.stepsMediaNumber') %>><%= content.ui.stepsMediaNumber %></span>
            <p><span<%- editAttr('ui.stepsMediaLineOne') %>><%= content.ui.stepsMediaLineOne %></span><br><span<%- editAttr('ui.stepsMediaLineTwo') %>><%= content.ui.stepsMediaLineTwo %></span></p>
          </div>
        </aside>

        <div class="tips-list">
          <% content.tips.items.forEach(function(tip, index) { %>
            <details class="tip-card reveal" <%= index === 0 ? 'open' : '' %>>
              <summary>
                <span class="tip-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                <span class="tip-icon"><%- icon(tip.icon) %></span>
                <span class="tip-summary">
                  <span class="tip-title"<%- editAttr('tips.items.' + index + '.title') %>><%= tip.title %></span>
                  <span class="tip-teaser"<%- editAttr('tips.items.' + index + '.summary') %>><%= tip.summary %></span>
                </span>
                <span class="tip-toggle" aria-hidden="true"><%- icon('plus') %></span>
              </summary>
              <div class="tip-body">
                <% tip.body.forEach(function(paragraph, paragraphIndex) { %>
                  <p<%- editAttr('tips.items.' + index + '.body.' + paragraphIndex) %>><%= paragraph %></p>
                <% }) %>
                <% if (tip.note) { %>
                  <p class="tip-note"><%- icon('info') %> <span<%- editAttr('tips.items.' + index + '.note') %>><%= tip.note %></span></p>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>
      </div>

      <div class="steps-closing reveal">
        <h3<%- editAttr('tips.closingHeading') %>><%= content.tips.closingHeading %></h3>
        <p<%- editAttr('tips.closingText') %>><%= content.tips.closingText %></p>
        <a class="text-link text-link-light" href="#start-helper"><span<%- editAttr('ui.notSure') %>><%= content.ui.notSure %></span> <%- icon('arrow-right') %></a>
      </div>

    </div>
  </section>

  <section class="helpful-section" id="helpful" aria-labelledby="helpful-title">
    <div class="container">
      <div class="helpful-card reveal">
        <span class="helpful-mark" aria-hidden="true"><%- icon('thumbs-up') %></span>
        <div class="helpful-copy">
          <p class="eyebrow eyebrow-dark"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('ui.helpfulEyebrow') %>><%= content.ui.helpfulEyebrow %></span></p>
          <h2 id="helpful-title"<%- editAttr('ui.helpfulHeading') %>><%= content.ui.helpfulHeading %></h2>
          <p<%- editAttr('ui.helpfulText') %>><%= content.ui.helpfulText %></p>
        </div>
        <div class="helpful-action">
          <form method="post" action="/helpful" class="helpful-form" data-helpful-form data-voted-label="<%= content.ui.helpfulVotedLabel %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="helpful-button" type="submit" data-helpful-button <%= helpfulVoted ? 'disabled' : '' %>>
              <span class="helpful-button-icon" aria-hidden="true"><%- icon('thumbs-up') %></span>
              <span data-helpful-button-label<%- editAttr(helpfulVoted ? 'ui.helpfulVotedLabel' : 'ui.helpfulButton') %>><%= helpfulVoted ? content.ui.helpfulVotedLabel : content.ui.helpfulButton %></span>
            </button>
            <p class="helpful-count" role="status" aria-live="polite">
              <strong data-helpful-count><%= formatNumber(helpfulCount) %></strong>
              <span data-helpful-count-label
                    data-one="<%= content.ui.helpfulCountOne %>"
                    data-many="<%= content.ui.helpfulCountLabel %>"<%- editAttr(helpfulCount === 1 ? 'ui.helpfulCountOne' : 'ui.helpfulCountLabel') %>><%= helpfulCount === 1 ? content.ui.helpfulCountOne : content.ui.helpfulCountLabel %></span>
            </p>
            <p class="helpful-error" data-helpful-error hidden><%= content.ui.helpfulError %></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper support-section" id="support" aria-labelledby="support-title">
    <div class="container">
      <div class="section-head section-head-paper section-head-centre reveal">
        <p class="eyebrow eyebrow-dark"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('support.eyebrow') %>><%= content.support.eyebrow %></span></p>
        <h2 id="support-title"<%- editAttr('support.heading') %>><%= content.support.heading %></h2>
        <p class="section-sub"<%- editAttr('support.subtitle') %>><%= content.support.subtitle %></p>
      </div>

      <div class="support-grid">
        <% content.support.organisations.forEach(function(org, index) { %>
          <% const logo = safeImage(org.logo || '', ''); %>
          <% const phoneHref = safePhoneHref(org.phone, ''); %>
          <% const textHref = smsHref(org.textHref, ''); %>
          <% const website = safeUrl(org.website, ''); %>
          <article class="support-card reveal" style="--org: <%= org.colour || '#6f8f83' %>; --i: <%= index %>">
            <div class="support-card-top">
              <div class="org-mark">
                <% if (logo) { %>
                  <img src="<%= logo %>" alt="<%= org.name %> logo" loading="lazy">
                <% } else { %>
                  <span<%- editAttr('support.organisations.' + index + '.mark') %>><%= org.mark %></span>
                <% } %>
              </div>
              <div>
                <h3<%- editAttr('support.organisations.' + index + '.name') %>><%= org.name %></h3>
                <p class="org-hours"><%- icon('clock') %> <span<%- editAttr('support.organisations.' + index + '.hours') %>><%= org.hours %></span></p>
              </div>
            </div>
            <p class="org-description"<%- editAttr('support.organisations.' + index + '.description') %>><%= org.description %></p>
            <div class="org-contact">
              <% if (org.phone && phoneHref) { %>
                <a class="org-phone" href="<%= phoneHref %>"><%- icon('phone') %> <span<%- editAttr('support.organisations.' + index + '.phone') %>><%= org.phone %></span></a>
              <% } %>
              <% if (org.textLabel && textHref) { %>
                <a class="org-text" href="<%= textHref %>"><%- icon('message-text') %> <span<%- editAttr('support.organisations.' + index + '.textLabel') %>><%= org.textLabel %></span></a>
              <% } %>
            </div>
            <% if (website) { %>
              <a class="org-link" href="<%= website %>" target="_blank" rel="noopener noreferrer">
                <%= content.ui.visitWebsite %> <span<%- editAttr('support.organisations.' + index + '.websiteLabel') %>><%= org.websiteLabel || 'website' %></span> <%- icon('external') %>
              </a>
            <% } %>
          </article>
        <% }) %>
      </div>

      <div class="support-foot reveal">
        <p><%- icon('info') %> <span<%- editAttr('support.note') %>><%= content.support.note %></span></p>
        <p class="checked-note"><%- icon('check') %> <span<%- editAttr('support.checkedLabel') %>><%= content.support.checkedLabel %></span></p>
      </div>
    </div>
  </section>

  <section class="section emergency-section" id="emergency" aria-labelledby="emergency-title">
    <div class="container emergency-grid">
      <div class="emergency-copy reveal">
        <p class="eyebrow eyebrow-warm"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('emergency.eyebrow') %>><%= content.emergency.eyebrow %></span></p>
        <h2 id="emergency-title"<%- editAttr('emergency.heading') %>><%= content.emergency.heading %></h2>
        <p class="emergency-intro"<%- editAttr('emergency.intro') %>><%= content.emergency.intro %></p>
        <p class="emergency-note"><%- icon('shield') %> <span<%- editAttr('emergency.note') %>><%= content.emergency.note %></span></p>
      </div>
      <div class="emergency-cards">
        <% content.emergency.cards.forEach(function(card, index) { %>
          <a class="emergency-card reveal" style="--i: <%= index %>"
             href="<%= safeActionHref(card.href) %>"
             <% if (card.external) { %>target="_blank" rel="noopener noreferrer"<% } %>>
            <span class="emergency-label"<%- editAttr('emergency.cards.' + index + '.label') %>><%= card.label %></span>
            <span class="emergency-value"<%- editAttr('emergency.cards.' + index + '.value') %>><%= card.value %></span>
            <span class="emergency-action"><span<%- editAttr('emergency.cards.' + index + '.actionLabel') %>><%= card.actionLabel %></span> <%- icon(card.external ? 'external' : 'arrow-right') %></span>
            <span class="emergency-card-note"<%- editAttr('emergency.cards.' + index + '.note') %>><%= card.note %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="community-section" aria-labelledby="community-title">
    <div class="community-media" aria-hidden="true">
      <img src="<%= safeImage(content.community.image, '/images/sunrise-path.jpg') %>" alt="<%= content.community.imageAlt %>" loading="lazy" width="1800" height="1200">
    </div>
    <div class="community-overlay" aria-hidden="true"></div>
    <div class="container community-inner">
      <div class="community-copy reveal">
        <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('community.eyebrow') %>><%= content.community.eyebrow %></span></p>
        <h2 id="community-title"<%- editAttr('community.heading') %>><%= content.community.heading %></h2>
        <% content.community.paragraphs.forEach(function(paragraph, index) { %>
          <p<%- editAttr('community.paragraphs.' + index) %>><%= paragraph %></p>
        <% }) %>
        <a class="btn btn-light" href="<%= safeUrl(content.community.url, '#') %>" target="_blank" rel="noopener noreferrer">
          <span<%- editAttr('community.buttonLabel') %>><%= content.community.buttonLabel %></span>
          <%- icon('external') %>
        </a>
        <p class="community-disclaimer"><%- icon('info') %> <span<%- editAttr('community.disclaimer') %>><%= content.community.disclaimer %></span></p>
      </div>
    </div>
  </section>

  <section class="faith-section" aria-labelledby="faith-title">
    <div class="container">
      <div class="faith-card reveal">
        <span class="faith-mark" aria-hidden="true"><%- icon('sunrise') %></span>
        <div class="faith-copy">
          <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('faith.eyebrow') %>><%= content.faith.eyebrow %></span></p>
          <h2 id="faith-title"<%- editAttr('faith.heading') %>><%= content.faith.heading %></h2>
          <p class="faith-text"<%- editAttr('faith.text') %>><%= content.faith.text %></p>
          <a class="text-link text-link-light faith-link" href="<%= safeUrl(content.faith.url, '#') %>" target="_blank" rel="noopener noreferrer">
            <span<%- editAttr('faith.linkLabel') %>><%= content.faith.linkLabel %></span>
            <%- icon('external') %>
          </a>
          <p class="faith-note"<%- editAttr('faith.note') %>><%= content.faith.note %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper donation-section" id="donate" aria-labelledby="donation-title">
    <div class="container">
      <div class="donation-card reveal">
        <span class="donation-mark" aria-hidden="true"><%- icon('coffee') %></span>
        <div class="donation-copy">
          <p class="eyebrow eyebrow-dark"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('donation.eyebrow') %>><%= content.donation.eyebrow %></span></p>
          <h2 id="donation-title"<%- editAttr('donation.heading') %>><%= content.donation.heading %></h2>
          <p<%- editAttr('donation.text') %>><%= content.donation.text %></p>
        </div>
        <div class="donation-action">
          <a class="btn btn-primary" href="<%= safeUrl(content.donation.url, '#') %>" target="_blank" rel="noopener noreferrer">
            <span<%- editAttr('donation.buttonLabel') %>><%= content.donation.buttonLabel %></span>
            <%- icon('external') %>
          </a>
          <p class="donation-note"<%- editAttr('donation.note') %>><%= content.donation.note %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="container closing-inner reveal">
      <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('closing.eyebrow') %>><%= content.closing.eyebrow %></span></p>
      <h2 id="closing-title"<%- editAttr('closing.heading') %>><%= content.closing.heading %></h2>
      <p class="closing-text"<%- editAttr('closing.text') %>><%= content.closing.text %></p>
      <p class="closing-quote"<%- editAttr('footer.closing') %>><%= content.footer.closing %></p>
      <a class="btn btn-primary" href="#about"><span<%- editAttr('closing.buttonLabel') %>><%= content.closing.buttonLabel %></span> <%- icon('arrow-down') %></a>
    </div>
  </section>
</main>

<%- include('partials/public-footer', { content, visitorCount }) %>

<dialog class="helper-dialog" id="start-helper-dialog" aria-labelledby="helper-dialog-title">
  <div class="dialog-inner">
    <form method="dialog" class="dialog-close-form">
      <button class="dialog-close" type="submit" aria-label="<%= content.startHelper.closeLabel %>">
        <%- icon('close') %>
      </button>
    </form>
    <p class="eyebrow eyebrow-dark"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('startHelper.eyebrow') %>><%= content.startHelper.eyebrow %></span></p>
    <h2 id="helper-dialog-title"<%- editAttr('startHelper.heading') %>><%= content.startHelper.heading %></h2>
    <p class="dialog-intro"<%- editAttr('startHelper.intro') %>><%= content.startHelper.intro %></p>
    <div class="dialog-options">
      <% content.startHelper.options.forEach(function(option, index) { %>
        <a class="dialog-option" href="<%= safeActionHref(option.actionHref) %>" data-close-dialog>
          <span class="dialog-option-icon"><%- icon(option.icon) %></span>
          <span class="dialog-option-copy">
            <strong<%- editAttr('startHelper.options.' + index + '.title') %>><%= option.title %></strong>
            <span<%- editAttr('startHelper.options.' + index + '.text') %>><%= option.text %></span>
            <em><span<%- editAttr('startHelper.options.' + index + '.actionLabel') %>><%= option.actionLabel %></span> <%- icon('arrow-right') %></em>
          </span>
        </a>
      <% }) %>
    </div>
    <p class="dialog-footnote"><%- icon('shield') %> <%= content.emergency.note %></p>
  </div>
