<%- include('partials/public-head', {
  content,
  pageTitle: 'Questions and where to get help',
  pageDescription: content.faq.intro,
  canonicalUrl: origin + '/faq',
  ogImage: origin + safeImage(content.hero.image, '/images/hero-forest.jpg'),
  noindex: preview,
  bodyClass: bodyClass || 'page-faq',
  preview,
  preloadImage: ''
}) %>
<%- include('partials/public-nav', { content, isHome: false, solidHeader: true }) %>

<main id="main" class="legal-main faq-main">
  <section class="page-hero">
    <div class="container page-hero-inner reveal">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/"><span<%- editAttr('ui.homeLabel') %>><%= content.ui.homeLabel %></span></a>
        <span aria-hidden="true">/</span>
        <span>Questions</span>
      </nav>
      <p class="eyebrow eyebrow-light"><span class="eyebrow-line" aria-hidden="true"></span><span<%- editAttr('faq.eyebrow') %>><%= content.faq.eyebrow %></span></p>
      <h1<%- editAttr('faq.heading') %>><%= content.faq.heading %></h1>
      <p class="page-intro"<%- editAttr('faq.intro') %>><%= content.faq.intro %></p>
    </div>
  </section>

  <section class="section section-paper faq-section">
    <div class="container legal-grid">
      <article class="legal-article faq-article reveal">
        <p class="faq-note"><%- icon('info') %> <span<%- editAttr('faq.note') %>><%= content.faq.note %></span></p>

        <div class="faq-list">
          <% content.faq.items.forEach(function(item, index) { %>
            <% const href = safeUrl(item.linkHref, '#'); %>
            <% const external = /^https?:\/\//i.test(href); %>
            <details class="faq-item" <%= index === 0 ? 'open' : '' %>>
              <summary>
                <span class="faq-question"<%- editAttr('faq.items.' + index + '.question') %>><%= item.question %></span>
                <span class="faq-toggle" aria-hidden="true"><%- icon('plus') %></span>
              </summary>
              <div class="faq-body">
                <p class="faq-answer"<%- editAttr('faq.items.' + index + '.answer') %>><%= item.answer %></p>
                <a class="text-link faq-link" href="<%= href %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %>>
                  <span<%- editAttr('faq.items.' + index + '.linkLabel') %>><%= item.linkLabel %></span>
                  <%- icon(external ? 'external' : 'arrow-right') %>
                </a>
              </div>
            </details>
          <% }) %>
        </div>
      </article>

      <aside class="legal-aside">
        <div class="aside-card reveal">
          <span class="aside-icon"><%- icon('shield') %></span>
          <h2<%- editAttr('ui.helpNowHeading') %>><%= content.ui.helpNowHeading %></h2>
          <p<%- editAttr('ui.helpNowText') %>><%= content.ui.helpNowText %></p>
          <a class="btn btn-primary btn-small" href="tel:999"><span<%- editAttr('ui.call999') %>><%= content.ui.call999 %></span></a>
          <a class="text-link" href="/#emergency"><span<%- editAttr('ui.allEmergency') %>><%= content.ui.allEmergency %></span> <%- icon('arrow-right') %></a>
        </div>
        <div class="aside-card aside-card-soft reveal">
          <span class="aside-icon"><%- icon('heart') %></span>
          <h2<%- editAttr('ui.listenHeading') %>><%= content.ui.listenHeading %></h2>
          <p<%- editAttr('ui.listenText') %>><%= content.ui.listenText %></p>
          <a class="aside-phone" href="<%= safePhoneHref(content.ui.listenPhone, '') %>"><%- icon('phone') %> <span<%- editAttr('ui.listenPhone') %>><%= content.ui.listenPhone %></span></a>
          <a class="text-link" href="/#support"><span<%- editAttr('ui.seeSupport') %>><%= content.ui.seeSupport %></span> <%- icon('arrow-right') %></a>
        </div>
      </aside>
    </div>
  </section>
</main>

<% if (!preview) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}).replace(/</g, '\\u003c') %>
</script>
<% } %>

<%- include('partials/public-footer', { content, visitorCount: null }) %>
<%- include('partials/owner-edit-link', { editHref: '/admin/preview/faq?edit=1' }) %>
<%- include('partials/inline-editor') %>
<% if (canInlineEdit) { %><script src="/js/inline-edit.js" defer></script><% } %>
<script src="/js/main.js" defer></script>
</body>
</html>
