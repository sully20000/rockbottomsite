<header class="site-header <%= solidHeader ? 'is-solid' : '' %>" data-header>
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="<%= content.site.title %> — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" role="img" focusable="false">
          <path d="M8 33V19a12 12 0 0 1 24 0v14" />
          <circle cx="20" cy="19" r="3.6" fill="currentColor" />
          <path d="M20 8v3" />
          <path d="M10.4 11.4l2.1 2.1" />
          <path d="M29.6 11.4l-2.1 2.1" />
          <path d="M4 19h3" />
          <path d="M33 19h3" />
          <path d="M13 33h14" />
          <path d="M16 37h8" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name"><%= content.hero.title.split('–')[0].trim() %></span>
        <span class="brand-sub"><%= content.hero.title.split('–').slice(1).join('–').trim() || 'The Way Back' %></span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <a href="<%= isHome ? '' : '/' %>#steps"><span<%- editAttr('nav.stepsLabel') %>><%= content.nav.stepsLabel %></span></a>
      <a href="<%= isHome ? '' : '/' %>#support"><span<%- editAttr('nav.supportLabel') %>><%= content.nav.supportLabel %></span></a>
      <a class="nav-emergency" href="<%= isHome ? '' : '/' %>#emergency">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span<%- editAttr('nav.emergencyLabel') %>><%= content.nav.emergencyLabel %></span>
      </a>
    </nav>

    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
      <span class="nav-toggle-label"<%- editAttr('ui.menuLabel') %>><%= content.ui.menuLabel %></span>
      <%- icon('menu', 'icon-menu') %>
      <%- icon('close', 'icon-close') %>
    </button>
  </div>
</header>

<%# Kept outside the blurred header: a backdrop-filter on an ancestor would
    become the containing block for this fixed full-screen panel. %>
<div class="mobile-nav" id="mobile-nav" hidden>
  <nav aria-label="Mobile">
    <a href="<%= isHome ? '' : '/' %>#steps"><span>01</span><%= content.nav.stepsLabel %></a>
    <a href="<%= isHome ? '' : '/' %>#support"><span>02</span><%= content.nav.supportLabel %></a>
    <a class="mobile-emergency" href="<%= isHome ? '' : '/' %>#emergency"><span>03</span><%= content.nav.emergencyLabel %></a>
  </nav>
  <p class="mobile-nav-note"><%= content.footer.emergencyNote %></p>
</div>
