<aside class="admin-sidebar" data-admin-sidebar>
  <div class="admin-brand">
    <a href="/admin" aria-label="Rock Bottom admin dashboard">
      <img class="brand-logo admin-brand-logo" src="/images/logo-mark.svg" alt="" width="64" height="43">
      <span>
        <strong>Rock Bottom</strong>
        <small>The Way Back</small>
      </span>
    </a>
    <span class="admin-badge">Admin</span>
  </div>

  <nav class="admin-nav" aria-label="Administrator">
    <p class="admin-nav-label">Dashboard</p>
    <a class="<%= active === 'overview' ? 'active' : '' %>" href="/admin">
      <%- icon('chart') %><span>Overview</span>
    </a>

    <p class="admin-nav-label">Website content</p>
    <a class="<%= active === 'home' ? 'active' : '' %>" href="/admin/edit/home">
      <%- icon('home') %><span>Homepage</span>
    </a>
    <a class="<%= active === 'symptoms' ? 'active' : '' %>" href="/admin/edit/symptoms">
      <%- icon('list') %><span>Symptoms section</span>
    </a>
    <a class="<%= active === 'tips' ? 'active' : '' %>" href="/admin/edit/tips">
      <%- icon('footsteps') %><span>Ten steps</span>
    </a>
    <a class="<%= active === 'daily' ? 'active' : '' %>" href="/admin/edit/daily">
      <%- icon('sunrise') %><span>Daily reminders</span>
    </a>
    <a class="<%= active === 'support' ? 'active' : '' %>" href="/admin/edit/support">
      <%- icon('heart') %><span>Support organisations</span>
    </a>
    <a class="<%= active === 'emergency' ? 'active' : '' %>" href="/admin/edit/emergency">
      <%- icon('shield') %><span>Emergency support</span>
    </a>
    <a class="<%= active === 'community' ? 'active' : '' %>" href="/admin/edit/community">
      <%- icon('users') %><span>Community</span>
    </a>
    <a class="<%= active === 'faq' ? 'active' : '' %>" href="/admin/edit/faq">
      <%- icon('message') %><span>Questions page</span>
    </a>
    <a class="<%= active === 'design' ? 'active' : '' %>" href="/admin/edit/design">
      <%- icon('palette') %><span>Design &amp; navigation</span>
    </a>
    <a class="<%= active === 'pages' ? 'active' : '' %>" href="/admin/edit/pages">
      <%- icon('book') %><span>Footer &amp; legal pages</span>
    </a>

    <p class="admin-nav-label">Site</p>
    <a class="<%= active === 'media' ? 'active' : '' %>" href="/admin/media">
      <%- icon('image') %><span>Media library</span>
    </a>
    <a class="<%= active === 'visitors' ? 'active' : '' %>" href="/admin/visitors">
      <%- icon('eye') %><span>Visitor statistics</span>
    </a>
    <a class="<%= active === 'account' ? 'active' : '' %>" href="/admin/account">
      <%- icon('lock') %><span>Your account</span>
    </a>
    <a class="<%= active === 'system' ? 'active' : '' %>" href="/admin/system">
      <%- icon('settings') %><span>System information</span>
    </a>
  </nav>

  <div class="admin-sidebar-foot">
    <div class="draft-state <%= hasChanges ? 'has-changes' : '' %>">
      <span class="draft-dot" aria-hidden="true"></span>
      <div>
        <strong><%= hasChanges ? 'Unpublished changes' : 'Everything is published' %></strong>
        <small><%= hasChanges ? 'Preview, then publish when ready.' : 'The live site matches your draft.' %></small>
      </div>
    </div>
    <div class="admin-user-row">
      <div class="admin-avatar" aria-hidden="true"><%= (admin?.username || 'A').slice(0, 1).toUpperCase() %></div>
      <span><%= admin?.username || 'Administrator' %></span>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="icon-button" type="submit" aria-label="Sign out" title="Sign out">
          <%- icon('logout') %>
        </button>
      </form>
    </div>
  </div>
</aside>
